    "playwright": "^1.57.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "recharts": "^3.6.0",
    "storybook": "^8.6.14",
    "tailwindcss": "4.1.12",
    "typescript": "^5.0.0",
    "vite": "6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.16"
  },
  "sideEffects": [
    "**/*.css"
  ]
}